<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Substrate matches classes, not framework bundle identifiers.  UIApplication
	     selects real UIKit apps; the constructor excludes SpringBoard and ZiYan. -->
	<key>Filter</key>
	<dict>
		<key>Classes</key>
		<array>
			<string>UIApplication</string>
		</array>
	</dict>
</dict>
</plist>
