      "include/": "C 头（自研）"
    },
    "/private/var/mobile/Media/ZiYan/": {
      "*.lua": "用户脚本",
      "res/": "资源/模板图"
    },
    "/Library/MobileSubstrate/DynamicLibraries/": {
      "ZiYanVol.*": "SpringBoard",
      "ZiYanAppTouch.*": "目标 App"
