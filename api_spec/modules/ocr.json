      "aliases": [
        "pyStrFind"
      ]
    },
    {
      "name": "findStr",
      "args": [
        "str",
        "x",
        "y",
        "x1",
        "y1"
      ],
      "returns": "x,y",
      "note": "找文字位置",
      "status": "partial",
      "aliases": [
        "pyFindStr"
      ]
    },
    {
      "name": "findNumber",
      "args": [
        "x",
        "y",
        "x1",
        "y1"
      ],
