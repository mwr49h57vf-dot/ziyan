      "note": "本地 tess 接口（可选）",
      "status": "partial",
      "aliases": []
    },
    {
      "name": "cloudOcrText",
      "args": [
        "user",
        "pass",
        "softid",
        "x",
        "y",
        "x1",
        "y1"
      ],
      "returns": "string",
      "note": "云 OCR（可选配置）",
      "status": "partial",
      "aliases": []
    },
    {
      "name": "ZiYanCV.ocr_backends",
      "args": [],
      "returns": "table",
      "note": "可用后端列表",
      "status": "done",
      "aliases": []
    },
    {
      "name": "ZiYanCV.capture_region",
      "args": [
        "x",
        "y",
        "x1",
        "y1",
        "path?"
      ],
      "returns": "table",
      "note": "裁剪区域图",
      "status": "done",
      "aliases": []
    }
