#!/bin/bash
# preinst — 默认安装/升级绝不改变现有进程生命周期。
# 新文件由 dpkg 原子替换；新注入与守护生效须由人工授权的独立激活步骤完成。
set +e

JB=""
[ -d /var/jb/usr ] && JB="/var/jb"
ROOT="${JB}/usr/lib/ziyan"
MARKER="$ROOT/var/.ziyan_inject_reload_pending"

mkdir -p "$ROOT/var" 2>/dev/null || true
{
  echo "status=pending_manual_inject_reload"
  echo "phase=preinst"
  echo "reason=package_install_or_upgrade_no_lifecycle_change"
} >"$MARKER" 2>/dev/null || true
chmod 666 "$MARKER" 2>/dev/null || true
exit 0
